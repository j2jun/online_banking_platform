# Optional: set to switch the support assistant from free demo answers to Claude.
# Copy to .env.local (git-ignored) and fill in. Leave unset to stay in demo mode.
ANTHROPIC_API_KEY=

# Self-hosting only (not needed on Vercel): set to true if your reverse proxy sets X-Real-IP,
# so the assistant also limits each visitor (20 messages / 10 min), not just the overall total.
TRUST_PROXY_IP_HEADER=
